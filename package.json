{
  "name": "cca-f-exam-prep",
  "version": "1.0.0",
  "private": true,
  "description": "Local study hub for Claude certifications: study plans, domain guides with diagrams, and simulated exams for CCAO-F, CCDV-F and CCAR-F",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
